WIFI_SSID = "network"
WIFI_PASSWORD = "pass"

MQTT_HOST = "example.com"
MQTT_PORT = 1883
MQTT_USER = "your-mqtt-username"
MQTT_PASSWORD = "your-mqtt-password"

HOT_BOX_ID = "1234567890"  # Creating a new box will give this ID

# Optional — only needed to point vault.py at something other than
# production (e.g. a local dev server while testing). The Nopal API TOKEN
# and PROJECT are deliberately NOT here — they're entered once per test via
# the WiFi captive portal itself (see portal.py/vault.py), not baked into
# the firmware.
# NOPAL_HOST = "https://nopal.build"
