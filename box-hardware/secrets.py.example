WIFI_SSID = "network"
WIFI_PASSWORD = "pass"

# This fallback is effectively unused in normal operation — main.py always
# passes the saved/portal-entered WiFi credentials to connectWifi()
# explicitly, so these only matter if you call connectWifi() with no
# arguments yourself (e.g. from a REPL while debugging). Real WiFi
# credentials and the Nopal API token/project are entered once per test via
# the WiFi captive portal (see portal.py), not baked into this file.

# Optional — only needed to point vault.py at something other than
# production (e.g. a local dev server while testing). Defaults to
# "https://o.nopal.build" (the product app -- NOT plain "nopal.build",
# which is the separate marketing site with no /api/vault/* routes at
# all) when unset.
# NOPAL_HOST = "https://o.nopal.build"
