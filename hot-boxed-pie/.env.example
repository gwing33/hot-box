# MQTT Configuration for Production
# Replace these values with your actual MQTT broker credentials
# Example for HiveMQ Cloud:
MQTT_BROKER_URL=mqtts://xxxxx.s1.eu.hivemq.cloud:8883
MQTT_USERNAME=your-username
MQTT_PASSWORD=your-password
MQTT_CLIENT_ID=hot-boxed-pie-prod

# Server Configuration
PORT=8080

# Topics
MQTT_MEASUREMENT_TOPIC=hotbox/+/measurement

# Debug (set to hot-boxed-pie:error in production)
DEBUG=hot-boxed-pie:error
